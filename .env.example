# The 0.5B model is suitable for a 1-vCPU/4-GB VPS. A larger VPS can use
# qwen2.5:1.5b for better conversation quality.
OLLAMA_MODEL=qwen2.5:0.5b

# Use 127.0.0.1 on an internet-facing VPS with Caddy or another reverse proxy.
CITADELLE_BIND_IP=127.0.0.1

# Public URL placed in the single-use link returned by the pwn container.
PUBLIC_APP_URL=https://citadelle.designo-group.com

# Keep this on localhost for local testing. Expose it only for a supervised
# session and restrict TCP 31337 at the VPS/provider firewall.
PWN_BIND_IP=127.0.0.1
